#!/bin/sh
# Fast commit-msg check (< 1s, zero Rust compilation): subject line `type(scope): what` or `type: what`.
set -e

subject=$(head -n 1 "$1" | tr -d '\r')
if printf '%s\n' "$subject" | grep -Eq '^(Merge |Revert |fixup! |squash! |(feat|fix|docs|test|chore|refactor|perf|ci|build|release)(\([^)]+\))?: .+)'; then
    exit 0
fi

echo "commit-msg: expected subject 'type(scope): summary' (e.g. 'docs(agents): trim workflow rules'), got: $subject"
exit 1
