#!/bin/sh
# Fast pre-commit guard (< 1s, zero Rust compilation): branch/path hygiene + PII scan.
# Skip once:        git commit --no-verify
# Turn off for good: git config --unset core.hooksPath
set -e

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [ "$branch" = "main" ]; then
    echo "pre-commit: refusing direct commit on 'main'. Use a feature branch or pass --no-verify."
    exit 1
fi

bad_staged=$(git diff --cached --name-only | grep -E '^(local/|target/|my-notebooks/)' || true)
if [ -n "$bad_staged" ]; then
    echo "pre-commit: refusing to stage ignored/scratch paths:"
    echo "$bad_staged"
    exit 1
fi

if ! bash SKILLS/nc-devx/scripts/check-pii.sh; then
    echo
    echo "pre-commit: PII check failed. Remove sensitive data and re-stage."
    exit 1
fi
