<?xml version="1.0" encoding="utf-8"?>
<!--
  Nocturne MSI (WiX Toolset v5: `dotnet tool install -g wix` at version 5.0.2, plus its UI and Util
  extensions: `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for
  WixToolset.Util.wixext/5.0.2). Built by package.ps1:

    wix build nocturne.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome and licence, progress, and a finish page.

  The app carries both generated Welcome notebook formats and asks once per app version before
  creating or replacing its dedicated per-user Welcome notebook. Other notebook folders remain
  unchanged.

  UpgradeCode and the component GUIDs below belong to Nocturne alone. Never change the
  UpgradeCode after the first public release: Windows Installer would stop treating a new
  version as an upgrade of the old one, and both would sit side by side.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Nocturne"
      Manufacturer="antimajorana"
      Version="$(var.Version)"
      UpgradeCode="C2662B42-6578-43FF-821B-818575EF96BD"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Nocturne note taking" Manufacturer="antimajorana" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Nocturne is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="NocturneIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="NocturneIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/antimajorana/Nocturne" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/antimajorana/Nocturne/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/antimajorana/Nocturne/issues" />

    <!-- WixUI_Minimal: welcome and licence, progress, then a finish page. The finish page offers
         to launch Nocturne (ticked by default); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Nocturne" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#NocturneExe]" />
    <CustomAction Id="LaunchNocturne" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <!-- The app offers its bundled Welcome notebook on first launch of each version. -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchNocturne"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Nocturne" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Nocturne" Level="1">
      <ComponentGroupRef Id="NocturneFiles" />
      <ComponentGroupRef Id="DemoFiles" />
      <ComponentGroupRef Id="LicenseFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="NocturneFiles" Directory="INSTALLFOLDER">
      <Component Id="NocturneApp" Guid="154A19E7-AB76-4B48-994F-8DE5BAE61F47">
        <File Id="NocturneExe" Source="$(var.BinDir)\nocturne.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Nocturne"
              Description="Nocturne note taking" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="NocturneIcon.ico" IconIndex="0" />
          <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Nocturne"
              Description="Nocturne note taking" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="NocturneIcon.ico" IconIndex="0" />
        </File>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\nocturne.exe" Value="[#NocturneExe]" Type="string" />
      </Component>

      <Component Id="FirstUseMarker" Guid="A2062015-AD07-4256-8130-46B476783F74">
        <File Id="FirstUseMarkerFile" Source="$(var.BinDir)\first-use.pending" KeyPath="yes" />
      </Component>
      <Component Id="NocturneCli" Guid="E3061CAE-99C3-48E0-8250-8C192AABBFFA">
        <File Id="NocturneCliExe" Source="$(var.BinDir)\nocturne-cli.exe" KeyPath="yes" />
      </Component>
      <ComponentRef Id="OfficeimoBridge" />
      <ComponentRef Id="Notices" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Read-only source content that the app copies into the user's notebook root. -->
      <Directory Id="DemoDir" Name="demo">
        <Directory Id="DemoNotebookDir" Name="welcome-to-nocturne">
        </Directory>
      </Directory>
      <!-- The notices every copy must carry: the licences and the third-party notices. -->
      <Component Id="Notices" Guid="FD6430D6-FBDD-431D-9A3B-8267B72103B4">
        <File Id="NoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
        <File Id="AttributionFile" Source="$(var.BinDir)\ATTRIBUTION.md" />
        <File Id="ProjectLicenseFile" Source="$(var.BinDir)\LICENSE" />
      </Component>
      <Directory Id="LicensesDir" Name="licenses" />
      <Directory Id="ImportersDir" Name="importers">
        <Directory Id="OfficeimoDir" Name="officeimo">
          <Directory Id="OfficeimoWinX64Dir" Name="win-x64">
            <Component Id="OfficeimoBridge" Guid="A6C5F87B-5A6E-4F00-9A9C-6ACF5E8FBB11">
              <File Id="OfficeimoBridgeExe" Source="$(var.BinDir)\importers\officeimo\win-x64\officeimo-nocturne.exe" KeyPath="yes" />
              <File Id="OfficeimoManifest" Source="$(var.BinDir)\importers\officeimo\manifest.json" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </DirectoryRef>
    <ComponentGroup Id="LicenseFiles" Directory="LicensesDir">
      <Files Include="$(var.BinDir)\licenses\**" />
    </ComponentGroup>
    <ComponentGroup Id="DemoFiles" Directory="DemoNotebookDir">
      <Files Include="$(var.BinDir)\demo\welcome-to-nocturne\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
